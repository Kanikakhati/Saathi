# Copy this file to .env and fill in real values before running.

# SQLite is fine for the hackathon demo. To point at Supabase/Postgres instead,
# swap in its connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./saathi.db

GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
